# Kickbase (Single-User-Altpfad — Collector nutzt es bis Phase 3)
KICKBASE_EMAIL=
KICKBASE_PASSWORD=
KICKBASE_LEAGUE_IDS=   # kommaseparierte Liste aller Ligen, z. B. 123,456,789

# Supabase — Server (Service-Role, RLS-Bypass; nur Server, nie ins Bundle!)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Supabase — Client/Auth (öffentlich, für Magic-Link-Login; @supabase/ssr)
NEXT_PUBLIC_SUPABASE_URL=https://bvbzvxgkltozepuaireg.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # anon/publishable Key aus dem Supabase-Dashboard

# Token-Verschlüsselung (Multi-User): 32 Byte, base64. Neu erzeugen mit:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
KB_TOKEN_ENC_KEY=

# Cron-Schutz (Vercel setzt CRON_SECRET in Prod automatisch; lokal selbst setzen)
CRON_SECRET=
